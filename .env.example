# ===========================================================================
# PipelineDoctor Environment Configuration (.env.example)
# ===========================================================================

# ── Local LLM Backend (Bionic / llama.cpp / vLLM) ──────────────────────────
# Base URL for the OpenAI-compatible REST server
BIONIC_BASE_URL=http://localhost:1235/v1

# Target model identifier (e.g., exact model ID from /v1/models)
BIONIC_MODEL=qwen3.5-9b-uncensored-hauhaucs-aggressive

# Maximum time (in seconds) to wait for LLM completion
LLM_TIMEOUT_SECONDS=120

# Token budget per call (must be >= 1500 to accommodate reasoning/thinking tokens)
LLM_MAX_TOKENS=2000

# ── GitHub Integration ────────────────────────────────────────────────────
# Personal Access Token with 'repo' and 'actions:read' scopes
GITHUB_TOKEN=ghp_your_github_personal_access_token_here

# Secret used to verify GitHub webhook HMAC-SHA256 signatures (optional for local dev)
GITHUB_WEBHOOK_SECRET=your_github_webhook_hmac_secret_here

# ── Agent Orchestration & State Machine ───────────────────────────────────
# Hard cap on self-healing retry iterations before escalating to a human engineer
MAX_ITERATIONS=3

# ── Docker Execution Sandbox ──────────────────────────────────────────────
# Base container image used to execute verification suites
DOCKER_IMAGE=python:3.11-slim

# Maximum execution time (in seconds) allowed inside the ephemeral container
SANDBOX_TIMEOUT_SECONDS=180

# Working directory inside the container
SANDBOX_WORK_DIR=/workspace

# ── Control Plane API ─────────────────────────────────────────────────────
# Host and port for FastAPI webhook server
API_HOST=0.0.0.0
API_PORT=8000
