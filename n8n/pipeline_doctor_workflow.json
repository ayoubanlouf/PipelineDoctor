{
  "name": "PipelineDoctor - CI/CD Self-Healing & Alerting",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "github-workflow-failure",
        "responseMode": "onReceived",
        "responseData": "OK"
      },
      "id": "c1f7a012-3456-4789-abcd-0123456789ab",
      "name": "GitHub Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        180,
        300
      ],
      "webhookId": "github-workflow-failure"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-action-completed",
              "leftValue": "={{ $json.body?.action || '' }}",
              "rightValue": "completed",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            },
            {
              "id": "cond-conclusion-failure",
              "leftValue": "={{ $json.body?.workflow_run?.conclusion || '' }}",
              "rightValue": "failure",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "d2f7a012-3456-4789-abcd-0123456789ac",
      "name": "Is Failed Workflow Run?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        400,
        300
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "assign-repo",
              "name": "repo",
              "value": "={{ $json.body.repository.full_name }}",
              "type": "string"
            },
            {
              "id": "assign-branch",
              "name": "branch",
              "value": "={{ $json.body.workflow_run.head_branch }}",
              "type": "string"
            },
            {
              "id": "assign-sha",
              "name": "commit_sha",
              "value": "={{ $json.body.workflow_run.head_sha }}",
              "type": "string"
            },
            {
              "id": "assign-run-id",
              "name": "run_id",
              "value": "={{ $json.body.workflow_run.id }}",
              "type": "number"
            },
            {
              "id": "assign-workflow-name",
              "name": "workflow_name",
              "value": "={{ $json.body.workflow_run.name || 'CI Workflow' }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "e3f7a012-3456-4789-abcd-0123456789ad",
      "name": "Extract Failure Context",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        620,
        280
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://pipelinedoctor:8000/heal",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"repo\": \"{{ $json.repo }}\",\n  \"branch\": \"{{ $json.branch }}\",\n  \"commit_sha\": \"{{ $json.commit_sha }}\",\n  \"run_id\": {{ $json.run_id }},\n  \"workflow_name\": \"{{ $json.workflow_name }}\"\n}",
        "options": {
          "timeout": 300000
        }
      },
      "id": "f4f7a012-3456-4789-abcd-0123456789ae",
      "name": "Trigger PipelineDoctor Heal",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        840,
        280
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-outcome-done",
              "leftValue": "={{ $json.phase }}",
              "rightValue": "done",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "a5f7a012-3456-4789-abcd-0123456789af",
      "name": "Check Healing Outcome",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1060,
        280
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://hooks.slack.com/services/REPLACE/WITH/YOUR_WEBHOOK",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"text\": \"🩺⚡ *PipelineDoctor Auto-Healed CI/CD Failure!*\",\n  \"blocks\": [\n    {\n      \"type\": \"header\",\n      \"text\": {\n        \"type\": \"plain_text\",\n        \"text\": \"🩺⚡ PipelineDoctor Auto-Healed CI/CD Failure!\",\n        \"emoji\": true\n      }\n    },\n    {\n      \"type\": \"section\",\n      \"fields\": [\n        {\n          \"type\": \"mrkdwn\",\n          \"text\": \"*Repository:*\\n`{{ $json.repo }}`\"\n        },\n        {\n          \"type\": \"mrkdwn\",\n          \"text\": \"*Run ID:*\\n{{ $json.run_id }}\"\n        },\n        {\n          \"type\": \"mrkdwn\",\n          \"text\": \"*Iterations to Fix:*\\n{{ $json.iteration }} / 3\"\n        },\n        {\n          \"type\": \"mrkdwn\",\n          \"text\": \"*Fix Branch:*\\n`{{ $json.fix_branch }}`\"\n        }\n      ]\n    },\n    {\n      \"type\": \"section\",\n      \"text\": {\n        \"type\": \"mrkdwn\",\n        \"text\": \"*Deterministic Docker sandbox verification passed (exit code 0).*\\n🔗 <{{ $json.pr_url }}|View Draft Pull Request>\"\n      }\n    }\n  ]\n}",
        "options": {}
      },
      "id": "b6f7a012-3456-4789-abcd-0123456789b0",
      "name": "Slack Alert: Healed & Draft PR Ready",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1320,
        180
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://hooks.slack.com/services/REPLACE/WITH/YOUR_WEBHOOK",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"text\": \"🚨 *PipelineDoctor Escalation Alert — Human Review Required*\",\n  \"blocks\": [\n    {\n      \"type\": \"header\",\n      \"text\": {\n        \"type\": \"plain_text\",\n        \"text\": \"🚨 PipelineDoctor Escalation Alert\",\n        \"emoji\": true\n      }\n    },\n    {\n      \"type\": \"section\",\n      \"fields\": [\n        {\n          \"type\": \"mrkdwn\",\n          \"text\": \"*Repository:*\\n`{{ $json.repo }}`\"\n        },\n        {\n          \"type\": \"mrkdwn\",\n          \"text\": \"*Run ID:*\\n{{ $json.run_id }}\"\n        },\n        {\n          \"type\": \"mrkdwn\",\n          \"text\": \"*Status:*\\n⚠️ Max iterations (3 loops) exhausted\"\n        },\n        {\n          \"type\": \"mrkdwn\",\n          \"text\": \"*Guardrail:*\\nZero unverified PRs created\"\n        }\n      ]\n    },\n    {\n      \"type\": \"section\",\n      \"text\": {\n        \"type\": \"mrkdwn\",\n        \"text\": \"*Root Cause / Errors:*\\n```{{ ($json.errors && $json.errors.length) ? $json.errors.join('\\n') : 'External infrastructure failure or non-deterministic test regression' }}```\"\n      }\n    }\n  ]\n}",
        "options": {}
      },
      "id": "c7f7a012-3456-4789-abcd-0123456789b1",
      "name": "Slack Alert: Escalated for Human Review",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1320,
        380
      ]
    }
  ],
  "pinData": {},
  "connections": {
    "GitHub Webhook Trigger": {
      "main": [
        [
          {
            "node": "Is Failed Workflow Run?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Is Failed Workflow Run?": {
      "main": [
        [
          {
            "node": "Extract Failure Context",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Extract Failure Context": {
      "main": [
        [
          {
            "node": "Trigger PipelineDoctor Heal",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Trigger PipelineDoctor Heal": {
      "main": [
        [
          {
            "node": "Check Healing Outcome",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Healing Outcome": {
      "main": [
        [
          {
            "node": "Slack Alert: Healed & Draft PR Ready",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Slack Alert: Escalated for Human Review",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
